{
  "title": "Markets tested",
  "type": "object",
  "required": [
    "countries"
  ],
  "additionalProperties": false,
  "properties": {
    "demo": {
      "type": "boolean"
    },
    "countries": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "language"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "partners": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note_en": {
            "type": "string"
          },
          "note_uk": {
            "type": "string"
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://citere.ai/schemas/countries.schema.json"
}
