{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Citation drift",
  "description": "The published industry baseline for how much of an assistant's cited-domain set changes month to month. Not a Citere measurement: it exists so a between-run change can be read against the noise floor (CLAUDE_CODE_BRIEF §4, /chatbots).",
  "type": "object",
  "additionalProperties": false,
  "required": ["note_en", "source", "products"],
  "properties": {
    "demo": { "type": "boolean" },
    "note_en": { "type": "string" },
    "source": { "type": "string" },
    "updated": { "type": "string", "format": "date" },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "rate"],
        "properties": {
          "key": { "type": ["string", "null"] },
          "label": { "type": "string" },
          "rate": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
