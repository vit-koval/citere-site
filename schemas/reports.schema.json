{
  "title": "Report index",
  "type": "object",
  "required": [
    "reports"
  ],
  "additionalProperties": false,
  "properties": {
    "demo": {
      "type": "boolean"
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "title_uk": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "run": {
            "type": "string"
          },
          "countries": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2}$"
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2}$"
            }
          },
          "chatbots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "n_responses": {
            "type": "integer",
            "minimum": 0
          },
          "dataset_url": {
            "type": "string"
          },
          "doi": {
            "type": "string"
          },
          "pdf_url": {
            "type": "string"
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://citere.ai/schemas/reports.schema.json"
}
