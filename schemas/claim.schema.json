{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://citere.ai/schemas/claim.schema.json",
  "title": "Sitera claim",
  "type": "object",
  "required": [
    "id",
    "slug",
    "cluster",
    "title_en",
    "verdict",
    "verdict_date",
    "updated",
    "languages",
    "countries",
    "origin",
    "splice",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^C[0-9]+-[0-9]{3}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60
    },
    "cluster": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "title_uk": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "false",
        "misleading",
        "unsupported"
      ]
    },
    "verdict_date": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}$"
      }
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}$"
      }
    },
    "grain_of_truth": {
      "type": "boolean"
    },
    "origin": {
      "type": "object",
      "required": [
        "first_seen",
        "network"
      ],
      "additionalProperties": false,
      "properties": {
        "first_seen": {
          "type": "string",
          "format": "date"
        },
        "origin_note_en": {
          "type": "string"
        },
        "origin_note_uk": {
          "type": "string"
        },
        "network": {
          "enum": [
            "pravda",
            "doppelganger",
            "matryoshka",
            "storm-1516",
            "state-media",
            "laundering",
            "other"
          ]
        },
        "attribution": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/attribution"
          }
        }
      }
    },
    "confirmations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "org",
          "finding_en",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "org": {
            "type": "string"
          },
          "finding_en": {
            "type": "string"
          },
          "finding_uk": {
            "type": "string"
          },
          "official": {
            "type": "boolean"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "note_en"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "note_en": {
            "type": "string"
          },
          "note_uk": {
            "type": "string"
          }
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^C[0-9]+-[0-9]{3}$"
      }
    },
    "demo": {
      "type": "boolean"
    },
    "splice": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "label": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "dormant",
        "archived"
      ]
    },
    "version": {
      "type": "string"
    },
    "debunk_argument": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertion",
          "refutation"
        ],
        "properties": {
          "assertion": {
            "type": "string"
          },
          "refutation": {
            "type": "string"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "surface_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "type"
        ],
        "properties": {
          "object": {
            "type": "string"
          },
          "type": {
            "enum": [
              "outlet",
              "clone",
              "marker",
              "artifact",
              "brand",
              "person"
            ]
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "found_in": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "attribution": {
      "type": "object",
      "required": [
        "org",
        "date"
      ],
      "additionalProperties": false,
      "properties": {
        "org": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "measurement": {
      "type": "object",
      "required": [
        "rate",
        "n",
        "date"
      ],
      "additionalProperties": false,
      "properties": {
        "rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "model_version": {
          "type": "string"
        },
        "persona": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ]
        }
      }
    }
  }
}
