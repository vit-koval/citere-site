{
  "title": "Assistant metadata and per-run aggregates",
  "type": "object",
  "required": [
    "platforms"
  ],
  "additionalProperties": false,
  "properties": {
    "demo": {
      "type": "boolean"
    },
    "platforms": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "chatgpt",
          "gemini",
          "grok",
          "claude",
          "copilot",
          "perplexity",
          "deepseek",
          "le-chat"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "company",
          "initials"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          },
          "model_versions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://citere.ai/schemas/platforms.schema.json"
}
