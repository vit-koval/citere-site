{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://citere.ai/schemas/clusters.schema.json",
  "title": "Claim clusters",
  "type": "object",
  "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
  "additionalProperties": {
    "type": "object",
    "required": ["name_en"],
    "additionalProperties": false,
    "properties": {
      "name_en": { "type": "string" },
      "name_uk": { "type": "string" }
    }
  }
}
