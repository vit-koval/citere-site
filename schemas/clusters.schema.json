{
  "title": "Claim clusters",
  "type": "object",
  "required": [
    "clusters"
  ],
  "additionalProperties": false,
  "properties": {
    "demo": {
      "type": "boolean"
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label_en"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "label_en": {
            "type": "string"
          },
          "label_uk": {
            "type": "string"
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://citere.ai/schemas/clusters.schema.json"
}
