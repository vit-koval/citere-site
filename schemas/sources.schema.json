{
  "title": "Domain watchlist (public subset)",
  "type": "object",
  "required": [
    "domains"
  ],
  "additionalProperties": false,
  "properties": {
    "demo": {
      "type": "boolean"
    },
    "version": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "domain",
          "slug",
          "network",
          "first_seen"
        ],
        "additionalProperties": false,
        "properties": {
          "domain": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "network": {
            "enum": [
              "pravda",
              "doppelganger",
              "matryoshka",
              "storm-1516",
              "state-media",
              "laundering",
              "other"
            ]
          },
          "label": {
            "type": "string"
          },
          "first_seen": {
            "type": "string",
            "format": "date"
          },
          "note_en": {
            "type": "string"
          },
          "note_uk": {
            "type": "string"
          },
          "attribution": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "org",
                "date"
              ],
              "additionalProperties": false,
              "properties": {
                "org": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          },
          "cited_in": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "citations": {
            "type": "integer",
            "minimum": 0
          },
          "complaints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target",
                "date",
                "status"
              ],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "status": {
                  "enum": [
                    "submitted",
                    "acknowledged",
                    "actioned",
                    "no_response",
                    "declined",
                    "completed"
                  ]
                }
              }
            }
          },
          "article_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string"
                },
                "host": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "to_review",
                    "confirmed",
                    "dismissed"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "claim_id": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://citere.ai/schemas/sources.schema.json"
}
