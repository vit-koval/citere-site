{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Runs",
  "description": "One record per run x market. A run is one cluster set, one country, one language, with frozen versions (Citere_Calculation_Methodology.md 0.2). Derived by scripts/build-metrics.mjs; never hand-edited.",
  "type": "object",
  "required": ["runs"],
  "properties": {
    "demo": { "type": "boolean" },
    "low_n": { "type": "integer" },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "run_id", "market", "country", "language", "collected_at",
                     "received", "valid", "quarantined", "unresolved", "reconciliation",
                     "judge_validation", "versions", "comparable_with"],
        "properties": {
          "key": { "type": "string" },
          "run_id": { "type": "string" },
          "market": { "type": "string", "pattern": "^[a-z]{2}-[a-z]{2}$" },
          "country": { "type": "string", "pattern": "^[a-z]{2}$" },
          "language": { "type": "string", "pattern": "^[a-z]{2}$" },
          "collected_at": { "type": "string", "format": "date" },
          "collected_until": { "type": "string", "format": "date" },
          "clusters": { "type": "array", "items": { "type": "string" } },
          "claims": { "type": "array", "items": { "type": "string" } },
          "claims_count": { "type": "integer", "minimum": 0 },
          "models": { "type": "array", "items": { "type": "string" } },
          "model_versions": { "type": "array", "items": { "type": "string" } },
          "personas": { "type": "array", "items": { "type": "string" } },
          "received": { "type": "integer", "minimum": 0 },
          "valid": { "type": "integer", "minimum": 0 },
          "quarantined": { "type": "integer", "minimum": 0 },
          "unresolved": { "type": "integer", "minimum": 0 },
          "prompts": { "type": ["integer", "null"] },
          "repeats": { "type": ["integer", "null"] },
          "reconciliation": {
            "type": "object", "additionalProperties": false,
            "required": ["expected", "received", "missing", "extra", "blocked", "known"],
            "properties": {
              "expected": { "type": ["integer", "null"] },
              "received": { "type": "integer", "minimum": 0 },
              "missing": { "type": ["integer", "null"] },
              "extra": { "type": ["integer", "null"] },
              "blocked": { "type": "boolean" },
              "known": { "type": "boolean" }
            }
          },
          "judge_validation": {
            "type": "object", "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": { "type": "string", "enum": ["pending", "confirmed", "not_confirmed"] },
              "alpha": { "type": ["number", "null"] }
            }
          },
          "versions": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "catalog": { "type": ["string", "null"] },
              "grid": { "type": ["string", "null"] },
              "judge": { "type": ["string", "null"] },
              "watchlist": { "type": ["string", "null"] }
            }
          },
          "comparable_with": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
