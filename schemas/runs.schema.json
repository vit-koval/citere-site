{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Runs (source table)",
  "description": "One record per data-collection run: one cluster, one country, one language, with the grid shape and the frozen versions (Citere_Entity_Model §5, Citere_Calculation_Methodology §0.2, §1.1). Written by the exporter. The derived per-run aggregates live in data/metrics.json.",
  "type": "object",
  "required": ["runs"],
  "additionalProperties": false,
  "properties": {
    "demo": { "type": "boolean" },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "cluster", "country", "language", "collected_at", "models", "claims"],
        "properties": {
          "run_id": { "type": "string" },
          "cluster": { "type": "string" },
          "country": { "type": "string", "pattern": "^[a-z]{2}$" },
          "language": { "type": "string", "pattern": "^[a-z]{2}$" },
          "collected_at": { "type": "string", "format": "date" },
          "collected_until": { "type": "string", "format": "date" },
          "claims": { "type": "array", "items": { "type": "string" } },
          "models": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "personas": { "type": "array", "items": { "enum": ["P1", "P2", "P3", "P4"] } },
          "prompts": { "type": ["integer", "null"], "minimum": 0 },
          "variations": { "type": ["integer", "null"], "minimum": 0 },
          "repeats": { "type": ["integer", "null"], "minimum": 0 },
          "live_prompts": { "type": ["integer", "null"], "minimum": 0 },
          "versions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "catalog": { "type": ["string", "null"] },
              "grid": { "type": ["string", "null"] },
              "judge": { "type": ["string", "null"] },
              "watchlist": { "type": ["string", "null"] }
            }
          },
          "judge_validation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": { "enum": ["pending", "confirmed", "not_confirmed"] },
              "alpha": { "type": ["number", "null"] }
            }
          }
        }
      }
    }
  }
}
