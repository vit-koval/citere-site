{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sitera.ai/schemas/site.schema.json",
  "title": "Site-wide data",
  "type": "object",
  "required": [
    "domain",
    "org",
    "counters",
    "last_update"
  ],
  "additionalProperties": false,
  "properties": {
    "domain": {
      "type": "string"
    },
    "org": {
      "type": "object",
      "required": [
        "name",
        "legal_name",
        "city",
        "country",
        "email"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "legal_name": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "founded": {
          "type": "string"
        },
        "diia_city_since": {
          "type": "string"
        },
        "funding": {
          "type": "string"
        },
        "email": {
          "type": "object",
          "required": [
            "research",
            "platforms",
            "press",
            "corrections"
          ],
          "additionalProperties": false,
          "properties": {
            "research": {
              "type": "string",
              "format": "email"
            },
            "platforms": {
              "type": "string",
              "format": "email"
            },
            "press": {
              "type": "string",
              "format": "email"
            },
            "corrections": {
              "type": "string",
              "format": "email"
            }
          }
        },
        "sameAs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "team": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "role"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "sameAs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "used_by": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "org",
          "title",
          "url",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "org": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "last_update": {
      "type": "string",
      "format": "date"
    },
    "watchlist_version": {
      "type": "string"
    },
    "methodology_version": {
      "type": "string"
    }
  }
}
