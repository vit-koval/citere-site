---
layout: layouts/base.njk
pageKey: index
pagination:
  data: build.languages
  alias: lang
  size: 1
permalink: "{{ '/' | loc(lang) }}"
---
{% set copyDoc = doc %}
{% set cycle = [
  { key: 'detect', nav: 'methodology' },
  { key: 'trace', nav: 'sources' },
  { key: 'publish', nav: 'registry' },
  { key: 'report', nav: 'escalations' },
  { key: 'confirm', nav: 'about' },
  { key: 're-measure', nav: 'reports' }
] %}
{% set trust = [
  { key: 'trust-method', nav: 'methodology' },
  { key: 'trust-data', nav: 'data' },
  { key: 'trust-actions', nav: 'escalations' },
  { key: 'trust-corrections', nav: 'corrections' }
] %}
{% set latest = claims | default([]) %}

<h1>{{ h1 }}</h1>
{% include "partials/translation-notice.njk" %}
<p class="lede">{{ copyDoc.introText }}</p>

{% if site.counters.claims %}
<ul class="counters">
  <li><b>{{ site.counters.claims }}</b><span>{{ (site.counters.claims | plural('counter.claim', 'counter.claims', 'counter.claimsFew')) | t }}</span></li>
  <li><b>{{ site.counters.responses }}</b><span>{{ (site.counters.responses | plural('counter.answer', 'counter.answers', 'counter.answersFew')) | t }}</span></li>
  <li><b>{{ site.counters.escalations_sent }}</b><span>{{ (site.counters.escalations_sent | plural('counter.report', 'counter.reports', 'counter.reportsFew')) | t }}</span></li>
</ul>
{% endif %}
{% include "partials/updated.njk" %}

{% if navigation.has.registry or navigation.has.reports %}
<p class="actions">
  {% if navigation.has.registry %}<a href="{{ '/registry/' | loc(lang) | url }}">{{ 'action.browseRegistry' | t }}</a>{% endif %}
  {% if navigation.has.reports %}<a href="{{ '/monitor/' | loc(lang) | url }}">{{ 'action.readReport' | t }}</a>{% endif %}
</p>
{% endif %}

<h2 id="the-problem">{{ copyDoc.sections['the-audience-is-the-model'].title }}</h2>
{{ copyDoc.sections['the-audience-is-the-model'].html | safe }}

<h2 id="what-we-do">{{ copyDoc.sections['what-we-do'].title }}</h2>
{{ copyDoc.sections['what-we-do'].html | safe }}

<ol class="cycle">
{% for step in cycle %}
  <li>
    <b>{{ loop.index }}. {{ copyDoc.sections[step.key].title }}</b>
    {{ copyDoc.sections[step.key].html | safe }}
    {% if navigation.byKey[step.nav] %}<p><a href="{{ navigation.byKey[step.nav].url | loc(lang) | url }}">{{ navigation.byKey[step.nav].label[lang] | default(navigation.byKey[step.nav].label.en) }}</a></p>{% endif %}
  </li>
{% endfor %}
</ol>
<p class="note">{{ 'note.metric' | t }}</p>

{% if latest | length %}
<h2 id="findings">{{ 'section.findings' | t }}</h2>
{% set tableClaims = latest | take(5) %}
{% set tableCaption = 'caption.claims' | t %}
{% include "partials/claims-table.njk" %}
{% if navigation.has.escalations and site.counters.escalations_sent %}
<p>{{ 'misc.escalationSummary' | t(site.counters.escalations_sent, site.counters.escalations_answered, site.counters.escalations_actioned) }} · <a href="{{ '/escalations/' | loc(lang) | url }}">{{ 'action.escalationLog' | t }}</a></p>
{% endif %}
{% endif %}

{% if site.used_by | length %}
<h2 id="used-by">{{ 'section.usedBy' | t }}</h2>
<ul>
{% for item in site.used_by %}
  <li><a href="{{ item.url }}">{{ item.org }} — {{ item.title }}</a>, <time datetime="{{ item.date | isoDate }}">{{ item.date | displayDate }}</time></li>
{% endfor %}
</ul>
{% endif %}

<h2 id="why-trust-this">{{ 'section.whyTrust' | t }}</h2>
<ul class="trust">
{% for item in trust %}
  <li>
    {{ copyDoc.sections[item.key].html | safe }}
    {% if navigation.byKey[item.nav] %}<a href="{{ navigation.byKey[item.nav].url | loc(lang) | url }}">{{ navigation.byKey[item.nav].label[lang] | default(navigation.byKey[item.nav].label.en) }}</a>{% endif %}
  </li>
{% endfor %}
</ul>
{{ copyDoc.sections['independence'].html | safe }}
{% if navigation.has.about %}<p><a href="{{ '/about/' | loc(lang) | url }}">{{ 'action.whoWeAre' | t }}</a></p>{% endif %}
