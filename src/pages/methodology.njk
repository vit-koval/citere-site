---
layout: layouts/page.njk
pageKey: methodology
pagination:
  data: build.languages
  alias: lang
  size: 1
permalink: "{{ '/methodology/' | loc(lang) }}"
crumbs:
  - key: crumb.methodology
    url: /methodology/
---
{% include "partials/translation-notice.njk" %}
<p class="lede">{{ doc.introText }}</p>
<p>{{ 'misc.methodologyVersion' | t(site.methodology_version, site.watchlist_version) }}</p>

{% for id in doc.order %}
{% set section = doc.sections[id] %}
<h2 id="{{ section.id }}">{{ section.title }}</h2>
{{ section.html | safe }}
{% endfor %}
