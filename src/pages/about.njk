---
layout: layouts/page.njk
pageKey: about
pagination:
  data: build.languages
  alias: lang
  size: 1
permalink: "{{ '/about/' | loc(lang) }}"
crumbs:
  - key: crumb.about
    url: /about/
---
{% include "partials/translation-notice.njk" %}
<p class="lede">{{ doc.introText }}</p>

<h2 id="the-organisation">{{ 'section.organisation' | t }}</h2>
<div class="table-wrap">
<table>
  <caption>{{ 'caption.registration' | t }}</caption>
  <tbody>
    <tr><th scope="row">{{ 'org.name' | t }}</th><td>{{ site.org.name }}</td></tr>
    {% if site.org.legal_name | isReal %}<tr><th scope="row">{{ 'org.legal' | t }}</th><td>{{ site.org.legal_name }}</td></tr>{% endif %}
    {% if site.org.city | isReal %}<tr><th scope="row">{{ 'org.registered' | t }}</th><td>{{ site.org.city }}, {{ site.org.country }}</td></tr>{% endif %}
    {% if site.org.founded | isReal %}<tr><th scope="row">{{ 'org.founded' | t }}</th><td><time datetime="{{ site.org.founded }}">{{ site.org.founded }}</time></td></tr>{% endif %}
    <tr><th scope="row">{{ 'org.diia' | t }}</th><td>{{ 'org.diiaSince' | t }} <time datetime="{{ site.org.diia_city_since }}">{{ site.org.diia_city_since + "-01" | displayDate }}</time></td></tr>
    <tr><th scope="row">{{ 'org.funding' | t }}</th><td>{{ site.org.funding }}, {{ 'org.fundingNote' | t }}</td></tr>
  </tbody>
</table>
</div>

{% if site.org.team | length %}
<h2 id="team">{{ 'section.team' | t }}</h2>
<ul>
{% for member in site.org.team %}
  <li><b>{{ member.name }}</b> — {{ member.role }}</li>
{% endfor %}
</ul>
{% endif %}

{% for id in doc.order %}
{% set section = doc.sections[id] %}
<h2 id="{{ section.id }}">{{ section.title }}</h2>
{{ section.html | safe }}
{% if section.id == 'contact' %}
<div class="table-wrap">
<table>
  <caption>{{ 'caption.contact' | t }}</caption>
  <tbody>
    <tr><th scope="row">{{ 'org.research' | t }}</th><td><a href="mailto:{{ site.org.email.research }}">{{ site.org.email.research }}</a></td></tr>
    <tr><th scope="row">{{ 'org.platforms' | t }}</th><td><a href="mailto:{{ site.org.email.platforms }}">{{ site.org.email.platforms }}</a></td></tr>
    <tr><th scope="row">{{ 'org.press' | t }}</th><td><a href="mailto:{{ site.org.email.press }}">{{ site.org.email.press }}</a></td></tr>
    <tr><th scope="row">{{ 'org.corrections' | t }}</th><td><a href="mailto:{{ site.org.email.corrections }}">{{ site.org.email.corrections }}</a></td></tr>
  </tbody>
</table>
</div>
{% endif %}
{% endfor %}
