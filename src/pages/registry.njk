---
layout: layouts/base.njk
schemas:
  - collectionpage
  - dataset
pageKey: registry
pagination:
  data: build.languages
  alias: lang
  size: 1
permalink: "{{ '/registry/' | loc(lang) }}"
crumbs:
  - key: crumb.registry
    url: /registry/
---
<h1>{{ h1 }}</h1>
{% include "partials/translation-notice.njk" %}
<p class="lede">{{ doc.introText }}</p>
{% include "partials/updated.njk" %}

<h2 id="how-to-read">{{ doc.sections['how-to-read'].title }}</h2>
{{ doc.sections['how-to-read'].html | safe }}

{% if facets | length %}
<h2 id="filters">{{ 'section.filter' | t }}</h2>
{% for group in ['cluster', 'country', 'language', 'chatbot', 'verdict'] %}
  {% set items = facets | whereEq('type', group) %}
  {% set headingKey = 'col.' + group %}
  {% if items | length %}
  <h3>{{ headingKey | t }}</h3>
  <ul class="menu-list">
  {% for facet in items %}
    <li><a href="{{ facet.url | loc(lang) | url }}">{{ facet.label }}</a> ({{ facet.claims | length }})</li>
  {% endfor %}
  </ul>
  {% endif %}
{% endfor %}
{% endif %}

<h2 id="claims">{{ 'section.allClaims' | t }}</h2>
{% set tableClaims = claims %}
{% set tableCaption = 'caption.claims' | t %}
{% include "partials/claims-table.njk" %}
