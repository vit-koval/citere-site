---
layout: layouts/base.njk
---
{% set prose = claim.prose.en %}
<h1>&ldquo;{{ claim.title_en }}&rdquo;</h1>
<p class="verdict-line">
  {% set badgeVerdict = claim.verdict %}{% include "partials/verdict-badge.njk" %}
  <span>· Verdict <time datetime="{{ claim.verdict_date | isoDate }}">{{ claim.verdict_date | displayDate }}</time>
  · Updated <time datetime="{{ claim.updated | isoDate }}">{{ claim.updated | displayDate }}</time>
  · ID {{ claim.id }}
  · Cluster: <a href="{{ ('/registry/cluster/' + claim.cluster + '/') | url }}">{{ clusters[claim.cluster].name_en | default(claim.cluster) }}</a></span>
</p>
<p>Recorded in {{ claim.observations | length }} chatbot answers across {% for code in claim.countries %}<a href="{{ ('/registry/country/' + code + '/') | url }}">{{ code | countryName }}</a>{% if not loop.last %}, {% endif %}{% endfor %}, in {% for code in claim.languages %}<a href="{{ ('/registry/language/' + code + '/') | url }}">{{ code | languageName }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.</p>
{% include "partials/updated.njk" %}

<h2 id="the-verdict">The verdict</h2>
{{ prose.sections['verdict'].html | safe }}

<h2 id="what-is-true">What is true</h2>
{{ prose.sections['what-is-true'].html | safe }}

<h2 id="where-the-claim-comes-from">Where the claim comes from</h2>
{{ prose.sections['where-the-claim-comes-from'].html | safe }}
<p>First recorded <time datetime="{{ claim.origin.first_seen | isoDate }}">{{ claim.origin.first_seen | displayDate }}</time>; spread through the {{ claim.origin.network | networkLabel }} network{% if claim.origin.attribution | length %}, attributed by {% for item in claim.origin.attribution %}{% if item.url %}<a href="{{ item.url | url }}">{{ item.org }}</a>{% else %}{{ item.org }}{% endif %} (<time datetime="{{ item.date | isoDate }}">{{ item.date | displayDate }}</time>){% if not loop.last %}, {% endif %}{% endfor %}{% endif %}.</p>

{% if claim.confirmations | length %}
<h2 id="who-else-has-checked-this">Who else has checked this</h2>
<div class="table-wrap">
<table>
  <caption>Independent organisations that reached the same conclusion.</caption>
  <thead>
    <tr><th scope="col">Organisation</th><th scope="col">Finding</th><th scope="col">Date</th></tr>
  </thead>
  <tbody>
  {% for item in claim.confirmations %}
    <tr>
      <th scope="row">{% if item.url %}<a href="{{ item.url | url }}">{{ item.org }}</a>{% else %}{{ item.org }}{% endif %}{% if item.official %} <small>(official)</small>{% endif %}</th>
      <td>{{ item.finding_en }}</td>
      <td><time datetime="{{ item.date | isoDate }}">{{ item.date | displayDate }}</time></td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endif %}

<h2 id="which-chatbots-repeated-it">Which chatbots repeated it</h2>
{% include "partials/observations-table.njk" %}

{% if claim.citedDomains | length %}
<h2 id="sources-the-chatbots-cited">Sources the chatbots cited</h2>
<p>Domains are printed defanged and never linked, so this page passes them no authority.</p>
<ul>
{% for domain in claim.citedDomains %}
  <li><span class="domain">{{ domain | defang }}</span>{% if navigation.has.sources %} — <a href="{{ ('/sources/' + (domain | domainSlug) + '/') | url }}">what this domain is</a>{% endif %}</li>
{% endfor %}
</ul>
{% endif %}

<h2 id="what-we-did">What we did</h2>
{% include "partials/actions-table.njk" %}

{% if claim.before_after | length %}
<h2 id="what-changed">What changed</h2>
{% include "partials/before-after-table.njk" %}
{% endif %}

{% if claim.changelog | length %}
<h2 id="changelog">Changelog</h2>
<ul>
{% for entry in claim.changelog %}
  <li><time datetime="{{ entry.date | isoDate }}">{{ entry.date | displayDate }}</time> — {{ entry.note_en }}</li>
{% endfor %}
</ul>
{% endif %}

<h2 id="cite-this-page">Cite this page</h2>
{% include "partials/cite.njk" %}

{% if claim.related | length %}
<h2 id="related-claims">Related claims</h2>
<ul>
{% for id in claim.related %}
  {% set other = claims | whereEq('id', id) | first %}
  {% if other %}<li><a href="{{ other.url | url }}">{{ other.title_en }}</a></li>{% endif %}
{% endfor %}
</ul>
{% endif %}
