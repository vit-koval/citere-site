---
layout: layouts/base.njk
wrap: wrap-narrow
---
<div class="phead">
  <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:14px;font-size:13px;color:var(--dimmer)">
    <span class="badge {{ claim.verdict | verdictClass }}" style="font-size:12px;padding:5px 11px">{{ claim.verdict | verdictLabel }}</span>
    <span>Verdict issued <time datetime="{{ claim.verdict_date | isoDate }}">{{ claim.verdict_date | displayDate }}</time></span><span>&middot;</span>
    <span>Updated <time datetime="{{ claim.updated | isoDate }}">{{ claim.updated | displayDate }}</time></span>
    <span>&middot;</span><span>ID {{ claim.id }}</span></div>
  <h1 style="font-size:29px;line-height:1.24;max-width:30ch">&ldquo;{{ claim.titles[lang] | default(claim.title_en) }}&rdquo;</h1>
  <div class="tiles" style="margin-top:4px">
    <a class="tile" href="{{ ('/registry/cluster/' + claim.cluster + '/') | url }}">{{ clusters[claim.cluster].name_en | default(claim.cluster) }}</a>
    <span class="tile">{% for l in claim.languages %}{{ l | upper }}{% if not loop.last %} &middot; {% endif %}{% endfor %}</span>
    <span class="tile">Grain of truth: {{ "yes" if claim.grain_of_truth else "no" }}</span></div>
</div>

<div class="prose" style="max-width:none">
  <h2 id="the-verdict">{{ 'claim.verdict' | t }}</h2>
  {{ prose.sections['verdict'].html | prefixLinks | defangCopy | safe }}

  <h2 id="what-is-true">{{ 'claim.whatIsTrue' | t }}</h2>
  {{ prose.sections['what-is-true'].html | prefixLinks | defangCopy | safe }}

  {%- if claim.grain_of_truth and benchmarks.headline %}
  <div class="callout">In {{ benchmarks.headline.run_label }}, chatbots refuted pure inventions
    <b>{{ benchmarks.headline.pure_refuted | rate }}</b> of the time, but repeated claims built on a
    grain of truth in <b>{{ benchmarks.headline.grain_repeated | rate }}</b> of non-evasive answers.</div>
  {%- endif %}

  <h2 id="where-the-claim-comes-from">{{ 'claim.origin' | t }}</h2>
  {{ prose.sections['where-the-claim-comes-from'].html | prefixLinks | defangCopy | safe }}
  <p>First seen <time datetime="{{ claim.origin.first_seen | isoDate }}">{{ claim.origin.first_seen | displayDate }}</time>
    on the {{ claim.origin.network | networkName }} network{% if claim.origin.attribution | length %}, attributed by
    {% for a in claim.origin.attribution %}{% if a.url %}<a href="{{ a.url }}">{{ a.org }}</a>{% else %}{{ a.org }}{% endif %}
    (<time datetime="{{ a.date | isoDate }}">{{ a.date | displayDate }}</time>){% if not loop.last %} and {% endif %}{% endfor %}{% endif %}.</p>
</div>

{%- if claim.confirmations | length %}
<h2 id="who-else-has-checked-this" style="margin:36px 0 12px">{{ 'claim.whoElse' | t }}</h2>
<div class="panel"><table>
  <caption class="visually-hidden">Independent organisations that reached the same conclusion</caption>
  <thead><tr><th scope="col">{{ 'col.organisation' | t }}</th><th scope="col">{{ 'col.finding' | t }}</th><th scope="col">{{ 'col.date' | t }}</th></tr></thead>
  <tbody>
  {%- for c in claim.confirmations %}
    <tr><td>{% if c.url %}<a href="{{ c.url }}">{{ c.org }}</a>{% else %}{{ c.org }}{% endif %}</td>
      <td style="color:var(--dim)">{{ c.finding_en }}</td>
      <td class="num" style="color:var(--dimmer)"><time datetime="{{ c.date | isoDate }}">{{ c.date | shortDate }}</time></td></tr>
  {%- endfor %}
  </tbody></table></div>
{%- endif %}

<h2 id="which-chatbots-repeated-it" style="margin:36px 0 8px">{{ 'claim.whichChatbots' | t }}</h2>
{% include "partials/observations-table.njk" %}

{%- if claim.citedDomains | length %}
<h2 id="sources-the-chatbots-cited" style="margin:36px 0 12px">{{ 'claim.sourcesCited' | t }}</h2>
<div class="panel"><table>
  <caption class="visually-hidden">Watchlisted domains cited in the recorded answers. Domains are printed defanged and never linked.</caption>
  <tbody>
  {%- for domain in claim.citedDomains %}
    {%- set source = sources | whereEq('domain', domain) | first %}
    <tr><td><span class="domain">{{ domain | defang }}</span></td>
      <td>{% if source %}<span class="netchip {{ source.network | networkClass }}">{{ source.network | networkLabel }}</span>{% endif %}</td>
      <td style="text-align:right">{% if navigation.has.sources and source %}<a href="{{ ('/sources/' + source.slug + '/') | url }}" style="color:var(--accent);font-weight:600;font-size:13px">View domain &rarr;</a>{% endif %}</td></tr>
  {%- endfor %}
  </tbody></table></div>
{%- endif %}

<h2 id="what-we-did" style="margin:36px 0 12px">{{ 'claim.whatWeDid' | t }}</h2>
{% include "partials/actions-table.njk" %}

{%- if claim.before_after | length %}
<h2 id="what-changed" style="margin:36px 0 12px">{{ 'claim.whatChanged' | t }}</h2>
{% include "partials/before-after-table.njk" %}
{%- endif %}

{%- if claim.changelog | length %}
<h2 id="changelog" style="margin:36px 0 12px">{{ 'claim.changelog' | t }}</h2>
<div class="panel"><table>
  <caption class="visually-hidden">What changed on this page, and when</caption>
  <tbody>
  {%- for entry in claim.changelog %}
    <tr><td class="num" style="color:var(--dimmer);width:1%;white-space:nowrap"><time datetime="{{ entry.date | isoDate }}">{{ entry.date | displayDate }}</time></td>
      <td style="color:var(--dim)">{{ entry.note_en }}</td></tr>
  {%- endfor %}
  </tbody></table></div>
{%- endif %}

<div class="exports" style="margin:28px 0 40px">
  <a href="{{ ('/registry/' + claim.slug + '.json') | url }}">{{ 'claim.getJson' | t }}</a><span>&middot;</span>
  <a href="{{ ('/registry/' + claim.slug + '.md') | url }}">{{ 'claim.getMarkdown' | t }}</a>
  {%- if navigation.has.data %}<span>&middot;</span><a href="{{ '/data/#cite' | url }}">{{ 'claim.cite' | t }}</a>{% endif %}
</div>
