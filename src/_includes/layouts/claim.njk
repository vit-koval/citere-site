---
layout: layouts/base.njk
---
<h1>&ldquo;{{ claim.title_en }}&rdquo;</h1>
<p class="verdict-line">
  {% set badgeVerdict = claim.verdict %}{% include "partials/verdict-badge.njk" %}
  <span>· {{ 'claim.verdictIssued' | t }} <time datetime="{{ claim.verdict_date | isoDate }}">{{ claim.verdict_date | displayDate }}</time>
  · {{ 'col.updated' | t }} <time datetime="{{ claim.updated | isoDate }}">{{ claim.updated | displayDate }}</time>
  · {{ 'claim.id' | t }} {{ claim.id }}
  · {{ 'claim.cluster' | t }}: <a href="{{ ('/registry/cluster/' + claim.cluster + '/') | loc(lang) | url }}">{{ clusters[claim.cluster].name_en | default(claim.cluster) }}</a></span>
</p>
<p>{% for code in claim.countries %}<a href="{{ ('/registry/country/' + code + '/') | loc(lang) | url }}">{{ code | countryName }}</a>{% if not loop.last %}, {% endif %}{% endfor %} · {% for code in claim.languages %}<a href="{{ ('/registry/language/' + code + '/') | loc(lang) | url }}">{{ code | languageName }}</a>{% if not loop.last %}, {% endif %}{% endfor %} · {{ claim.observations | length }} {{ 'col.answers' | t | lower }}</p>
{% include "partials/updated.njk" %}
{% include "partials/translation-notice.njk" %}

<h2 id="the-verdict">{{ 'claim.verdict' | t }}</h2>
{{ prose.sections[prose.order[0]].html | safe }}

<h2 id="what-is-true">{{ 'claim.whatIsTrue' | t }}</h2>
{{ prose.sections[prose.order[1]].html | safe }}

<h2 id="where-the-claim-comes-from">{{ 'claim.origin' | t }}</h2>
{{ prose.sections[prose.order[2]].html | safe }}
<p><time datetime="{{ claim.origin.first_seen | isoDate }}">{{ claim.origin.first_seen | displayDate }}</time> · {{ claim.origin.network | networkLabel }}{% if claim.origin.attribution | length %} · {% for item in claim.origin.attribution %}{% if item.url %}<a href="{{ item.url }}">{{ item.org }}</a>{% else %}{{ item.org }}{% endif %} (<time datetime="{{ item.date | isoDate }}">{{ item.date | displayDate }}</time>){% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</p>

{% if claim.confirmations | length %}
<h2 id="who-else-has-checked-this">{{ 'claim.whoElse' | t }}</h2>
<div class="table-wrap">
<table>
  <caption>{{ 'caption.confirmations' | t }}</caption>
  <thead>
    <tr><th scope="col">{{ 'col.organisation' | t }}</th><th scope="col">{{ 'col.finding' | t }}</th><th scope="col">{{ 'col.date' | t }}</th></tr>
  </thead>
  <tbody>
  {% for item in claim.confirmations %}
    <tr>
      <th scope="row">{% if item.url %}<a href="{{ item.url }}">{{ item.org }}</a>{% else %}{{ item.org }}{% endif %}{% if item.official %} <small>({{ 'claim.official' | t }})</small>{% endif %}</th>
      <td>{{ item.finding_en }}</td>
      <td><time datetime="{{ item.date | isoDate }}">{{ item.date | displayDate }}</time></td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endif %}

<h2 id="which-chatbots-repeated-it">{{ 'claim.whichChatbots' | t }}</h2>
{% include "partials/observations-table.njk" %}

{% if claim.citedDomains | length %}
<h2 id="sources-the-chatbots-cited">{{ 'claim.sourcesCited' | t }}</h2>
<p>{{ 'note.defang' | t }}</p>
<ul>
{% for domain in claim.citedDomains %}
  <li><span class="domain">{{ domain | defang }}</span>{% if navigation.has.sources %} — <a href="{{ ('/sources/' + (domain | domainSlug) + '/') | loc(lang) | url }}">{{ 'action.whatThisDomainIs' | t }}</a>{% endif %}</li>
{% endfor %}
</ul>
{% endif %}

<h2 id="what-we-did">{{ 'claim.whatWeDid' | t }}</h2>
{% include "partials/actions-table.njk" %}

{% if claim.before_after | length %}
<h2 id="what-changed">{{ 'claim.whatChanged' | t }}</h2>
{% include "partials/before-after-table.njk" %}
{% endif %}

{% if claim.changelog | length %}
<h2 id="changelog">{{ 'claim.changelog' | t }}</h2>
<ul>
{% for entry in claim.changelog %}
  <li><time datetime="{{ entry.date | isoDate }}">{{ entry.date | displayDate }}</time> — {{ entry.note_en }}</li>
{% endfor %}
</ul>
{% endif %}

<h2 id="cite-this-page">{{ 'claim.cite' | t }}</h2>
{% include "partials/cite.njk" %}

{% if claim.related | length %}
<h2 id="related-claims">{{ 'claim.related' | t }}</h2>
<ul>
{% for id in claim.related %}
  {% set other = claims | whereEq('id', id) | first %}
  {% if other %}<li><a href="{{ other.url | loc(lang) | url }}">{{ other.title_en }}</a></li>{% endif %}
{% endfor %}
</ul>
{% endif %}
