---
layout: layouts/base.njk
---
<h1>{{ report.title_en }}</h1>
<p class="lede">{{ stats.answers }} {{ 'col.answers' | t | lower }} · {{ stats.chatbots | length }} {{ 'col.chatbots' | t | lower }} · {% for code in stats.countries %}{{ code | countryName }}{% if not loop.last %}, {% endif %}{% endfor %} · <time datetime="{{ stats.firstDate | isoDate }}">{{ stats.firstDate | displayDate }}</time> — <time datetime="{{ stats.lastDate | isoDate }}">{{ stats.lastDate | displayDate }}</time></p>
{% include "partials/updated.njk" %}
{% include "partials/translation-notice.njk" %}

<nav aria-label="{{ 'nav.contents' | t }}">
  <h2 id="contents">{{ 'nav.contents' | t }}</h2>
  <ol>
    <li><a href="#key-findings">{{ 'section.keyFindings' | t }}</a></li>
    <li><a href="#scope">{{ 'section.scope' | t }}</a></li>
    <li><a href="#results-by-chatbot">{{ 'section.resultsByChatbot' | t }}</a></li>
    <li><a href="#results-by-country">{{ 'section.resultsByCountry' | t }}</a></li>
    <li><a href="#layer-b">{{ 'section.layerB' | t }}</a></li>
    <li><a href="#what-we-tested">{{ prose.sections['what-we-tested'].title }}</a></li>
    <li><a href="#what-changed-since-the-last-report">{{ prose.sections['what-changed-since-the-last-report'].title }}</a></li>
    <li><a href="#limitations">{{ prose.sections['limitations'].title }}</a></li>
    <li><a href="#methodology">{{ 'section.methodology' | t }}</a></li>
    <li><a href="#downloads">{{ 'section.downloads' | t }}</a></li>
  </ol>
</nav>

{% set figures = {
  answers: stats.answers,
  claims: stats.claims,
  chatbots: stats.chatbots | length,
  countries: stats.countries | length,
  first_date: stats.firstDate | displayDate,
  last_date: stats.lastDate | displayDate,
  repeated: stats.byChatbot | sumField("repeated"),
  contextualised: stats.byChatbot | sumField("contextualised"),
  refuted: stats.byChatbot | sumField("refuted"),
  dodged: stats.byChatbot | sumField("dodged"),
  contaminated: stats.contaminated
} %}

<h2 id="key-findings">{{ 'section.keyFindings' | t }}</h2>
{{ prose.sections['key-findings'].text | fill(figures) | md | safe }}

<h2 id="scope">{{ 'section.scope' | t }}</h2>
<div class="table-wrap">
<table>
  <caption>{{ 'caption.scope' | t }}</caption>
  <tbody>
    <tr><th scope="row">{{ 'col.month' | t }}</th><td>{{ report.period }}</td></tr>
    <tr><th scope="row">{{ 'col.report' | t }}</th><td>{{ report.runs | join(", ") }}</td></tr>
    <tr><th scope="row">{{ 'col.chatbots' | t }}</th><td>{% for bot in stats.chatbots %}{{ bot | chatbotLabel }}{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>
    <tr><th scope="row">{{ 'col.countries' | t }}</th><td>{% for code in stats.countries %}{{ code | countryName }}{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>
    <tr><th scope="row">{{ 'col.language' | t }}</th><td>{% for code in stats.languages %}{{ code | languageName }}{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>
    <tr><th scope="row">{{ 'col.persona' | t }}</th><td>{{ stats.personas | join(", ") }}</td></tr>
    <tr><th scope="row">{{ 'col.answers' | t }}</th><td>{{ stats.answers }}</td></tr>
    <tr><th scope="row">{{ 'col.claims' | t }}</th><td>{{ stats.claims }}</td></tr>
    <tr><th scope="row">{{ 'col.date' | t }}</th><td><time datetime="{{ stats.firstDate | isoDate }}">{{ stats.firstDate | displayDate }}</time> to <time datetime="{{ stats.lastDate | isoDate }}">{{ stats.lastDate | displayDate }}</time></td></tr>
  </tbody>
</table>
</div>

<h2 id="results-by-chatbot">{{ 'section.resultsByChatbot' | t }}</h2>
<div class="table-wrap">
<table>
  <caption>{{ 'caption.byChatbotPersona' | t }}</caption>
  <thead>
    <tr>
      <th scope="col">{{ 'col.chatbot' | t }}</th><th scope="col">{{ 'col.persona' | t }}</th>
      <th scope="col" class="num">{{ 'col.answers' | t }}</th><th scope="col" class="num">{{ 'col.repeated' | t }}</th>
      <th scope="col" class="num">{{ 'col.contextualised' | t }}</th><th scope="col" class="num">{{ 'col.refuted' | t }}</th>
      <th scope="col" class="num">{{ 'col.dodged' | t }}</th><th scope="col" class="num">{{ 'col.repeatRate' | t }}</th>
    </tr>
  </thead>
  <tbody>
  {% for row in stats.byChatbotPersona %}
    <tr>
      <th scope="row">{{ row.chatbot | chatbotLabel }}</th>
      <td data-persona="{{ row.persona }}">{{ row.persona }}</td>
      <td class="num">{{ row.n }}</td>
      <td class="num">{{ row.repeated }}</td>
      <td class="num">{{ row.contextualised }}</td>
      <td class="num">{{ row.refuted }}</td>
      <td class="num">{{ row.dodged }}</td>
      <td class="num">{% if row.nonEvasive %}{{ row.repeatRate | rate }} <small>(n={{ row.nonEvasive }})</small>{% else %}{{ 'value.na' | t }}{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>

<h2 id="results-by-country">{{ 'section.resultsByCountry' | t }}</h2>
<div class="table-wrap">
<table>
  <caption>{{ 'caption.byCountryPersona' | t }}</caption>
  <thead>
    <tr>
      <th scope="col">{{ 'col.country' | t }}</th><th scope="col">{{ 'col.persona' | t }}</th>
      <th scope="col" class="num">{{ 'col.answers' | t }}</th><th scope="col" class="num">{{ 'col.repeated' | t }}</th>
      <th scope="col" class="num">{{ 'col.refuted' | t }}</th><th scope="col" class="num">{{ 'col.dodged' | t }}</th>
      <th scope="col" class="num">{{ 'col.repeatRate' | t }}</th>
    </tr>
  </thead>
  <tbody>
  {% for row in stats.byCountryPersona %}
    <tr>
      <th scope="row">{{ row.country | countryName }}</th>
      <td data-persona="{{ row.persona }}">{{ row.persona }}</td>
      <td class="num">{{ row.n }}</td>
      <td class="num">{{ row.repeated }}</td>
      <td class="num">{{ row.refuted }}</td>
      <td class="num">{{ row.dodged }}</td>
      <td class="num">{% if row.nonEvasive %}{{ row.repeatRate | rate }} <small>(n={{ row.nonEvasive }})</small>{% else %}{{ 'value.na' | t }}{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>

<h2 id="layer-b">{{ 'section.layerB' | t }}</h2>
<p>{{ 'col.citedWatchlisted' | t }}: {{ stats.contaminated }} / {{ stats.answers }}.</p>
<div class="table-wrap">
<table>
  <caption>{{ 'caption.layerB' | t }}</caption>
  <thead>
    <tr><th scope="col">{{ 'col.chatbot' | t }}</th><th scope="col">{{ 'col.persona' | t }}</th><th scope="col" class="num">{{ 'col.answers' | t }}</th><th scope="col" class="num">{{ 'col.citedWatchlisted' | t }}</th></tr>
  </thead>
  <tbody>
  {% for row in stats.byChatbotPersona %}
    <tr>
      <th scope="row">{{ row.chatbot | chatbotLabel }}</th>
      <td data-persona="{{ row.persona }}">{{ row.persona }}</td>
      <td class="num">{{ row.n }}</td>
      <td class="num">{{ row.contaminated }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>

<h2 id="what-we-tested">{{ prose.sections['what-we-tested'].title }}</h2>
{{ prose.sections['what-we-tested'].text | fill(figures) | md | safe }}

<h2 id="what-changed-since-the-last-report">{{ prose.sections['what-changed-since-the-last-report'].title }}</h2>
{{ prose.sections['what-changed-since-the-last-report'].text | fill(figures) | md | safe }}

<h2 id="limitations">{{ prose.sections['limitations'].title }}</h2>
{{ prose.sections['limitations'].text | fill(figures) | md | safe }}

<h2 id="methodology">{{ 'section.methodology' | t }}</h2>
<p>{{ 'misc.methodologyVersion' | t(site.methodology_version, site.watchlist_version) }} <a href="{{ '/methodology/' | loc(lang) | url }}">{{ 'updated.how' | t }}</a></p>

<h2 id="downloads">{{ 'section.downloads' | t }}</h2>
<ul>
{% for item in reportDownloads %}
  <li><a href="{{ item.url | url }}">{{ item.label }}</a></li>
{% endfor %}
</ul>
{% if report.doi %}<p>{{ 'misc.doi' | t }} <a href="https://doi.org/{{ report.doi }}">{{ report.doi }}</a></p>{% endif %}
<p class="cite-block">{{ site.org.name }} ({{ report.date | year }}). {{ report.title_en }}. Sitera monitor {{ report.period }}. {{ site.url }}{{ ('/monitor/' + report.slug + '/') | loc(lang) }}</p>
