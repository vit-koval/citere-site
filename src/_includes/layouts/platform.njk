---
layout: layouts/base.njk
---
<h1>{{ platformHeading }}</h1>
<p class="lede">In the answers we have recorded, {{ profile.name }} repeated a documented false claim in {{ profile.stats.repeated }} of {{ profile.stats.nonEvasive }} non-evasive answers, declined {{ profile.stats.dodged }} times, and cited a domain on our watchlist in {{ profile.stats.contaminated }} of {{ profile.stats.answers }} answers. Rates are given per persona below, and never averaged across them. {{ profile.company }} has been notified of every finding on this page that carries a report date.</p>
{% include "partials/updated.njk" %}

<h2 id="by-month">{{ 'section.byMonth' | t }}</h2>
<div class="table-wrap">
<table>
  <caption>{{ 'caption.byMonth' | t }}</caption>
  <thead>
    <tr><th scope="col">{{ 'col.month' | t }}</th><th scope="col">{{ 'col.persona' | t }}</th><th scope="col" class="num">{{ 'col.answers' | t }}</th><th scope="col" class="num">{{ 'col.repeated' | t }}</th><th scope="col" class="num">{{ 'col.refuted' | t }}</th><th scope="col" class="num">{{ 'col.dodged' | t }}</th><th scope="col" class="num">{{ 'col.repeatRate' | t }}</th></tr>
  </thead>
  <tbody>
  {% for row in profile.stats.byMonthPersona %}
    <tr>
      <th scope="row">{{ row.month }}</th>
      <td data-persona="{{ row.persona }}">{{ row.persona }}</td>
      <td class="num">{{ row.n }}</td>
      <td class="num">{{ row.repeated }}</td>
      <td class="num">{{ row.refuted }}</td>
      <td class="num">{{ row.dodged }}</td>
      <td class="num">{% if row.nonEvasive %}{{ row.repeatRate | rate }} <small>(n={{ row.nonEvasive }})</small>{% else %}{{ 'value.na' | t }}{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>

<h2 id="by-country">{{ 'section.byCountry' | t }}</h2>
<div class="table-wrap">
<table>
  <caption>{{ 'caption.byCountryPersona' | t }}</caption>
  <thead>
    <tr><th scope="col">{{ 'col.country' | t }}</th><th scope="col">{{ 'col.persona' | t }}</th><th scope="col" class="num">{{ 'col.answers' | t }}</th><th scope="col" class="num">{{ 'col.repeated' | t }}</th><th scope="col" class="num">{{ 'col.citedWatchlisted' | t }}</th></tr>
  </thead>
  <tbody>
  {% for row in profile.stats.byCountryPersona %}
    <tr>
      <th scope="row">{{ row.country | countryName }}</th>
      <td data-persona="{{ row.persona }}">{{ row.persona }}</td>
      <td class="num">{{ row.n }}</td>
      <td class="num">{{ row.repeated }}</td>
      <td class="num">{{ row.contaminated }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>

{% if profile.repeatedClaims | length %}
<h2 id="claims-repeated">{{ 'section.claimsRepeated' | t(profile.name) }}</h2>
{% set tableClaims = profile.repeatedClaims %}
{% set tableCaption = 'caption.platformClaims' | t %}
{% include "partials/claims-table.njk" %}
{% endif %}

<h2 id="escalations">{{ 'section.reportsSentTo' | t(profile.company) }}</h2>
{% if profile.escalations | length %}
<div class="table-wrap">
<table>
  <caption>{{ 'caption.platformEscalations' | t }}</caption>
  <thead><tr><th scope="col">{{ 'col.date' | t }}</th><th scope="col">{{ 'col.claim' | t }}</th><th scope="col">{{ 'col.status' | t }}</th><th scope="col">{{ 'col.response' | t }}</th></tr></thead>
  <tbody>
  {% for item in profile.escalations %}
    {% set claim = claims | whereEq('id', item.claim_id) | first %}
    <tr>
      <td><time datetime="{{ item.date | isoDate }}">{{ item.date | displayDate }}</time></td>
      <td>{% if claim %}<a href="{{ claim.url | loc(lang) | url }}">{{ item.claim_id }}</a>{% else %}{{ item.claim_id }}{% endif %}</td>
      <td>{{ item.status | statusLabel }}</td>
      <td>{% if item.response_date %}<time datetime="{{ item.response_date | isoDate }}">{{ item.response_date | displayDate }}</time>{% else %}{{ 'value.dash' | t }}{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
<p class="note">{{ 'misc.disclosureNamed' | t(profile.company) }}</p>
{% else %}
<p>{{ 'misc.noEscalations' | t(profile.company) }}</p>
{% endif %}

{% if profile.beforeAfter | length %}
<h2 id="what-changed">{{ 'section.whatChangedAfter' | t }}</h2>
<div class="table-wrap">
<table>
  <caption>{{ 'caption.platformBeforeAfter' | t }}</caption>
  <thead><tr><th scope="col">{{ 'col.claim' | t }}</th><th scope="col">{{ 'col.persona' | t }}</th><th scope="col" class="num">{{ 'col.before' | t }}</th><th scope="col" class="num">{{ 'col.after' | t }}</th><th scope="col" class="num">{{ 'col.change' | t }}</th></tr></thead>
  <tbody>
  {% for row in profile.beforeAfter %}
    <tr>
      <th scope="row"><a href="{{ row.claim.url | loc(lang) | url }}">{{ row.claim.id }}</a></th>
      <td data-persona="{{ row.before.persona }}">{{ row.before.persona | default('value.notRecorded' | t) }}</td>
      <td class="num">{{ row.before.rate | rate }} <small>(n={{ row.before.n }})</small></td>
      <td class="num">{{ row.after.rate | rate }} <small>(n={{ row.after.n }})</small></td>
      <td class="num">{{ (row.after.rate - row.before.rate) | pp }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
<p class="note">{{ 'note.causation' | t }}</p>
{% endif %}

<p class="note">{{ 'note.publicInterface' | t }}</p>
