{#- Every filter on the log is also a URL (CLAUDE.md 2). Free-text search is
    the one the brief lists that cannot be a page; the CSV export covers it. -#}
<div class="filters">
  <a class="f{% if not activeFacet %} active{% endif %}" href="{{ '/countermeasures/' | url }}">All actions</a>
  {%- for group in ['type','status','target','market','claim'] %}
  {%- set items = countermeasureFacets | whereEq('type', group) %}
  {%- if items | length %}
  <details class="fdrop"{% if activeFacet and activeFacet.type == group %} open{% endif %}>
    <summary class="f{% if activeFacet and activeFacet.type == group %} active{% endif %}">{{ items[0].heading }} &#8964;</summary>
    <div class="fmenu">
      {%- for facet in items %}
      <a href="{{ facet.url | url }}"{% if activeFacet and activeFacet.url == facet.url %} aria-current="page"{% endif %}>{{ facet.label }} <span>{{ facet.actions | length }}</span></a>
      {%- endfor %}
    </div>
  </details>
  {%- endif %}
  {%- endfor %}
</div>
