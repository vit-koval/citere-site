<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" hreflang="en" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url }}">
{%- if navigation.has.rss %}
<link rel="alternate" type="application/rss+xml" title="{{ site.org.name }}" href="{{ '/feed.xml' | url }}">
{%- endif %}
<link rel="icon" href="data:,">
<link rel="stylesheet" href="{{ '/css/site.css' | url }}">
{% include "jsonld/organization.njk" %}
{% include "jsonld/website.njk" %}
{% include "jsonld/breadcrumblist.njk" %}
{% for type in schemas | default([]) %}{% include "jsonld/" + type + ".njk" %}{% endfor %}
