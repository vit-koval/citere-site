{#- Every filter the sources index offers is also its own URL, so the whole set
    works without JavaScript (CLAUDE.md 2, SR 10.1). -#}
<div class="filters">
  <a class="f{% if not activeFacet %} active{% endif %}" href="{{ '/sources/' | url }}">All domains</a>
  {%- for group in ['network','category','chatbot','market','flag'] %}
  {%- set items = sourceFacets | whereEq('type', group) %}
  {%- if items | length %}
  <details class="fdrop"{% if activeFacet and activeFacet.type == group %} open{% endif %}>
    <summary class="f{% if activeFacet and activeFacet.type == group %} active{% endif %}">{{ items[0].heading }} &#8964;</summary>
    <div class="fmenu">
      {%- for facet in items %}
      <a href="{{ facet.url | url }}"{% if activeFacet and activeFacet.url == facet.url %} aria-current="page"{% endif %}>{{ facet.label }} <span>{{ facet.sources | length }}</span></a>
      {%- endfor %}
    </div>
  </details>
  {%- endif %}
  {%- endfor %}
</div>
