{%- if breadcrumbTrail | length > 1 %}
<nav class="crumbs" aria-label="{{ 'nav.breadcrumb' | t }}">{% for crumb in breadcrumbTrail %}{% if loop.last %}<span aria-current="page">{{ crumb.title }}</span>{% else %}<a href="{{ crumb.url | loc(lang) | url }}">{{ crumb.title }}</a> / {% endif %}{% endfor %}</nav>
{%- endif %}
