{%- from "partials/bot-mark.njk" import markNotice -%}
<footer><div class="wrap">
    <div class="fcols">
      <div class="fcol fbrand">
        <div class="logo"><span class="mark"></span>{{ site.org.name }}</div>
        <p>Independent monitoring of public AI chatbots for Russian disinformation about Ukraine.
          Ukrainian research company, Diia.City resident.</p>
      </div>
      {%- for col in navigation.footer %}
      <div class="fcol"><h2>{{ col.heading | safe }}</h2>
        {%- for item in col.links %}
        <a href="{{ item.url | url }}">{{ item.label | safe }}</a>
        {%- endfor %}
      </div>
      {%- endfor %}
    </div>
    {%- if pageHasMarks %}
    {#- Trademark line, required on any page that shows a vendor mark. Driven
        off the rendered page, so it cannot drift out of step with the marks. -#}
    {{ markNotice(logos, lang | default("en")) }}
    {%- endif %}
    <div class="fbot">
      <span>&copy; {{ site.last_update | year }} {{ site.org.name }} &middot; Data under CC BY 4.0 &middot; Updated <time datetime="{{ site.last_update | isoDate }}">{{ site.last_update | displayDate }}</time></span>
      {%- if navigation.legal | length %}
      <span class="legal">{% for item in navigation.legal %}<a href="{{ item.url | url }}">{{ item.label | safe }}</a>{% endfor %}</span>
      {%- endif %}
    </div>
  </div></footer>
