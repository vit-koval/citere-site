<div class="panel"><table>
  <caption class="visually-hidden">{{ tableCaption }}</caption>
  <thead><tr>
    <th scope="col">Claim</th><th scope="col">Verdict</th><th scope="col">Repeated by</th>
    <th scope="col">Status</th><th scope="col">Updated{% if sortedByUpdated %} &darr;{% endif %}</th>
  </tr></thead>
  <tbody>
  {%- for item in tableClaims %}
    <tr>
      <td class="cl"><a href="{{ item.url | url }}">&ldquo;{{ item.title_en }}&rdquo;</a>
        <small>{{ clusters[item.cluster].name_en | default(item.cluster) }} &middot; {{ item.langLabel }}</small></td>
      <td>{% set badgeVerdict = item.verdict %}{% include "partials/verdict-badge.njk" %}</td>
      <td>{% set stackBots = item.repeatedBy %}{% set stackTotal = stackTotalOverride %}{% include "partials/bot-stack.njk" %}</td>
      <td>{%- if item.status %}<span class="chip {{ item.status.cls }}"><span class="dot"></span>{{ item.status.label }}</span>{% endif %}</td>
      <td class="num" style="color:var(--dim)"><time datetime="{{ item.updated | isoDate }}">{{ item.updated | shortDate }}</time></td>
    </tr>
  {%- endfor %}
  </tbody></table>
  {%- if tableFoot %}
  <div class="summary-line" style="border-bottom:0;border-top:1px solid var(--line2)">{{ tableFoot | safe }}</div>
  {%- endif %}
</div>
