<header><div class="wrap bar">
    <a class="logo" href="{{ '/' | url }}"><span class="mark"></span>{{ site.org.name }}</a>
    <nav aria-label="Main">{% for item in navigation.main %}<a href="{{ item.url | url }}"{% if navKey == item.key %} class="on" aria-current="page"{% endif %}>{{ item.label | safe }}</a>{% endfor %}</nav>
    <div class="spacer"></div>
    <a class="search" href="{{ '/registry/' | url if navigation.has.registry else '/' | url }}">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      Search claims, chatbots, domains<span class="kbd">&#8984;K</span>
    </a>
  </div></header>
