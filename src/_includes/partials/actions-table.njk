<p>{{ claim.counts.actions }} {{ 'col.action' | t | lower }} · {{ claim.counts.responses }} {{ 'col.response' | t | lower }}{% if claim.remeasuredOn %} · {{ 'col.remeasured' | t | lower }} <time datetime="{{ claim.remeasuredOn | isoDate }}">{{ claim.remeasuredOn | displayDate }}</time>{% endif %}</p>
<div class="table-wrap">
<table>
  <caption>{{ 'caption.actions' | t }}</caption>
  <thead>
    <tr><th scope="col">{{ 'col.action' | t }}</th><th scope="col">{{ 'col.to' | t }}</th><th scope="col">{{ 'col.date' | t }}</th><th scope="col">{{ 'col.status' | t }}</th></tr>
  </thead>
  <tbody>
  {% for action in claim.actions %}
    <tr>
      <th scope="row">{{ action.type | actionTypeLabel }}</th>
      <td>{% if action.url %}<a href="{{ action.url }}">{{ action.target }}</a>{% else %}{{ action.target }}{% endif %}</td>
      <td><time datetime="{{ action.date | isoDate }}">{{ action.date | displayDate }}</time></td>
      <td>{{ action.status | statusLabel }}{% if action.response_date %} <time datetime="{{ action.response_date | isoDate }}">{{ action.response_date | displayDate }}</time>{% endif %}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
<p class="note">{{ 'note.disclosure' | t }}</p>
