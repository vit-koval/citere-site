<div class="table-wrap">
<table>
  <caption>Repeat-rate before and after we reported this claim, per chatbot and per persona.</caption>
  <thead>
    <tr>
      <th scope="col">Chatbot</th>
      <th scope="col">Persona</th>
      <th scope="col" class="num">Before</th>
      <th scope="col">Measured</th>
      <th scope="col" class="num">After</th>
      <th scope="col">Re-measured</th>
      <th scope="col" class="num">Change</th>
    </tr>
  </thead>
  <tbody>
  {% for row in claim.before_after %}
    <tr>
      <th scope="row">{{ row.chatbot | chatbotLabel }}</th>
      <td data-persona="{{ row.before.persona }}">{{ row.before.persona | default("not recorded") }}</td>
      <td class="num">{{ row.before.rate | rate }} <small>(n={{ row.before.n }})</small></td>
      <td><time datetime="{{ row.before.date | isoDate }}">{{ row.before.date | displayDate }}</time>{% if row.before.model_version %}, {{ row.before.model_version }}{% endif %}</td>
      <td class="num">{{ row.after.rate | rate }} <small>(n={{ row.after.n }})</small></td>
      <td><time datetime="{{ row.after.date | isoDate }}">{{ row.after.date | displayDate }}</time>{% if row.after.model_version %}, {{ row.after.model_version }}{% endif %}</td>
      <td class="num">{{ (row.after.rate - row.before.rate) | pp }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
<p class="note">Models are updated continuously and independently of our reports. We record the version at both measurements and publish the change without claiming causation we cannot demonstrate.</p>
