{%- set ba = claim.before_after -%}
<div class="panel"><table>
  <caption class="visually-hidden">Repeat-rate before and after we reported this claim, persona {{ (ba | first).persona }} only, never averaged across personas</caption>
  <thead><tr><th scope="col">Chatbot</th>
    <th scope="col">Before (<time datetime="{{ (ba | first).before.date | isoDate }}">{{ (ba | first).before.date | shortDate }}</time>)</th>
    <th scope="col">After (<time datetime="{{ (ba | first).after.date | isoDate }}">{{ (ba | first).after.date | shortDate }}</time>)</th>
    <th scope="col">Change</th></tr></thead>
  <tbody>
  {%- for row in ba %}
    <tr data-persona="{{ row.persona }}">
      <td>{{ row.chatbot | botName }}</td>
      <td class="num">{{ row.before.rate | rate }}</td>
      <td class="num">{{ row.after.rate | rate }}</td>
      <td class="rmeta" style="color:var({{ '--ok' if (row.after.rate - row.before.rate) < -0.005 else '--dim' }})">{{ (row.after.rate - row.before.rate) | pp }}</td>
    </tr>
  {%- endfor %}
  </tbody></table></div>
<p class="note">Measured under persona {{ (ba | first).persona }} &middot; {{ (ba | first).persona | personaLabel }}.
  Models are updated continuously and independently of our reports. We record the model
  version at both measurements and publish the change without claiming causation we cannot demonstrate.</p>
