{%- set tiers = {"critical":"crit","high":"high","review":"rev","low":"low","none":""} -%}
<div class="abx">
  <div></div><div class="colh">Sources clean</div><div class="colh">Sources flagged</div>
  {%- for row in benchmarks.abxRows %}
  <div class="rowh {{ row.cls }}">{{ row.label }}</div>
  <div class="cell {{ tiers[row.clean] }}"><div class="cn">{{ row.cleanN }}</div>
    <div class="ct{{ ' none' if not tiers[row.clean] }}">{% if tiers[row.clean] %}{{ row.clean | upper }}{% else %}&mdash;{% endif %}</div></div>
  <div class="cell {{ tiers[row.flagged] }}"><div class="cn">{{ row.flaggedN }}</div>
    <div class="ct{{ ' none' if not tiers[row.flagged] }}">{% if tiers[row.flagged] %}{{ row.flagged | upper }}{% else %}&mdash;{% endif %}</div></div>
  {%- endfor %}
</div>
