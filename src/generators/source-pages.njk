---
pagination:
  data: localised.sources
  size: 1
  alias: entry
layout: layouts/base.njk
permalink: "{{ entry.url }}"
---
<h1><span class="domain">{{ source.defanged }}</span></h1>
<p class="lede">{{ 'col.firstSeen' | t }}: <time datetime="{{ source.first_seen | isoDate }}">{{ source.first_seen | displayDate }}</time> · {{ source.network | networkLabel }} · {{ 'col.claims' | t }}: {{ source.citedCount }}</p>
{% include "partials/updated.njk" %}
<p>{{ 'note.defang' | t }}</p>

<h2 id="attribution">{{ 'section.attribution' | t }}</h2>
{% if source.attribution | length %}
<div class="table-wrap">
<table>
  <caption>{{ 'caption.attribution' | t }}</caption>
  <thead><tr><th scope="col">{{ 'col.organisation' | t }}</th><th scope="col">{{ 'col.date' | t }}</th></tr></thead>
  <tbody>
  {% for item in source.attribution %}
    <tr>
      <th scope="row">{% if item.url %}<a href="{{ item.url | url }}">{{ item.org }}</a>{% else %}{{ item.org }}{% endif %}</th>
      <td><time datetime="{{ item.date | isoDate }}">{{ item.date | displayDate }}</time></td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<p>{{ 'misc.noAttribution' | t }}</p>
{% endif %}

{% if source.claims | length %}
<h2 id="claims">{{ 'section.whereCited' | t }}</h2>
<div class="table-wrap">
<table>
  <caption>{{ 'caption.sourceClaims' | t }}</caption>
  <thead><tr><th scope="col">{{ 'col.claim' | t }}</th><th scope="col">{{ 'col.verdict' | t }}</th><th scope="col">{{ 'col.citedBy' | t }}</th><th scope="col">{{ 'col.updated' | t }}</th></tr></thead>
  <tbody>
  {% for item in source.claims %}
    <tr>
      <th scope="row"><a href="{{ item.url | loc(lang) | url }}">{{ item.title_en }}</a></th>
      <td><span class="badge badge-verdict badge-{{ item.verdict }}">{{ item.verdict | verdictLabel }}</span></td>
      <td>{% for o in item.observations %}{% if source.domain in o.cited_domains %}{{ o.chatbot | chatbotLabel }} ({{ o.country | upper }}){% if not loop.last %}, {% endif %}{% endif %}{% endfor %}</td>
      <td><time datetime="{{ item.updated | isoDate }}">{{ item.updated | displayDate }}</time></td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endif %}

<h2 id="complaints">{{ 'section.complaints' | t }}</h2>
{% if source.complaints | length %}
<div class="table-wrap">
<table>
  <caption>{{ 'caption.complaints' | t }}</caption>
  <thead><tr><th scope="col">{{ 'col.to' | t }}</th><th scope="col">{{ 'col.date' | t }}</th><th scope="col">{{ 'col.status' | t }}</th></tr></thead>
  <tbody>
  {% for item in source.complaints %}
    <tr>
      <th scope="row">{{ item.target }}</th>
      <td><time datetime="{{ item.date | isoDate }}">{{ item.date | displayDate }}</time></td>
      <td>{{ item.status | statusLabel }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
<p class="note">{{ 'note.disclosure' | t }}</p>
{% else %}
<p>{{ 'misc.noComplaints' | t }}</p>
{% endif %}

<p><a href="{{ '/sources/' | loc(lang) | url }}">{{ 'action.allDomains' | t(sources | length) }}</a></p>
