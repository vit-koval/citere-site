---
pagination:
  data: sources
  size: 1
  alias: source
layout: layouts/base.njk
lang: en
permalink: "{{ source.url }}"
---
<h1><span class="domain">{{ source.defanged }}</span></h1>
<p class="lede">We first recorded this domain in a chatbot answer on <time datetime="{{ source.first_seen | isoDate }}">{{ source.first_seen | displayDate }}</time>. It is on our watchlist as part of the {{ source.network | networkLabel }} network, and appears in {{ source.citedCount }} documented {% if source.citedCount == 1 %}claim{% else %}claims{% endif %}.</p>
{% include "partials/updated.njk" %}
<p>The domain is printed defanged and is not linked: this page passes it no authority.</p>

<h2 id="attribution">Attribution</h2>
{% if source.attribution | length %}
<div class="table-wrap">
<table>
  <caption>Who attributed this domain to a network, and when.</caption>
  <thead><tr><th scope="col">Organisation</th><th scope="col">Date</th></tr></thead>
  <tbody>
  {% for item in source.attribution %}
    <tr>
      <th scope="row">{% if item.url %}<a href="{{ item.url | url }}">{{ item.org }}</a>{% else %}{{ item.org }}{% endif %}</th>
      <td><time datetime="{{ item.date | isoDate }}">{{ item.date | displayDate }}</time></td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<p>No published attribution is recorded for this domain yet. We do not attribute networks ourselves, so this entry stays on the list only while the citation record stands.</p>
{% endif %}

{% if source.claims | length %}
<h2 id="claims">Where chatbots cited it</h2>
<div class="table-wrap">
<table>
  <caption>Claims whose recorded answers cited this domain.</caption>
  <thead><tr><th scope="col">Claim</th><th scope="col">Verdict</th><th scope="col">Cited by</th><th scope="col">Updated</th></tr></thead>
  <tbody>
  {% for item in source.claims %}
    <tr>
      <th scope="row"><a href="{{ item.url | url }}">{{ item.title_en }}</a></th>
      <td><span class="badge badge-verdict badge-{{ item.verdict }}">{{ item.verdict | verdictLabel }}</span></td>
      <td>{% for o in item.observations %}{% if source.domain in o.cited_domains %}{{ o.chatbot | chatbotLabel }} ({{ o.country | upper }}){% if not loop.last %}, {% endif %}{% endif %}{% endfor %}</td>
      <td><time datetime="{{ item.updated | isoDate }}">{{ item.updated | displayDate }}</time></td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endif %}

<h2 id="complaints">Complaints</h2>
{% if source.complaints | length %}
<div class="table-wrap">
<table>
  <caption>Abuse complaints we filed about this domain.</caption>
  <thead><tr><th scope="col">To</th><th scope="col">Date</th><th scope="col">Status</th></tr></thead>
  <tbody>
  {% for item in source.complaints %}
    <tr>
      <th scope="row">{{ item.target }}</th>
      <td><time datetime="{{ item.date | isoDate }}">{{ item.date | displayDate }}</time></td>
      <td>{{ item.status | statusLabel }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
</div>
<p class="note">We publish the fact, the recipient, the date and the status. We do not publish the content of a complaint.</p>
{% else %}
<p>We have filed no abuse complaint about this domain.</p>
{% endif %}

<p><a href="{{ '/sources/' | url }}">All {{ sources | length }} domains on the watchlist</a></p>
