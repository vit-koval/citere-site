{
  "name": "citere-site",
  "version": "0.1.0",
  "private": true,
  "description": "Citere public website - public evidence base for AI chatbot monitoring",
  "license": "CC-BY-4.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "rm -rf _site && eleventy",
    "check": "node scripts/check.mjs",
    "serve": "eleventy --serve",
    "import": "node scripts/import-citere.mjs",
    "all": "npm run validate && npm run build && npm run check && npm run lighthouse",
    "build:pages": "PATH_PREFIX=/citere-site/ CANONICAL_URL=https://vit-koval.github.io/citere-site rm -rf _site && PATH_PREFIX=/citere-site/ CANONICAL_URL=https://vit-koval.github.io/citere-site eleventy",
    "check:pages": "PATH_PREFIX=/citere-site/ CANONICAL_URL=https://vit-koval.github.io/citere-site node scripts/check.mjs",
    "lighthouse": "PATH_PREFIX=/ CANONICAL_URL=https://vit-koval.github.io/citere-site eleventy --output=_site-lighthouse && lhci autorun --config=lighthouserc.json"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@lhci/cli": "^0.15.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0"
  }
}
